# Biến môi trường của agent (tiêu chí 9). KHÔNG ghi secret thật vào file này.
# Dùng: cp .env.example .env   (file .env đã nằm trong .gitignore)

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security — tự tạo key:  python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=

# Redis — state của rate limit và cost guard
REDIS_URL=redis://localhost:6379/0

# Giới hạn
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0

# LLM (mock)
LLM_MODEL=mock-llm
